# -----------------------------------------------------------------------------
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.userosscache
*.sln.docstates
.vs/
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svclog

# -----------------------------------------------------------------------------
# Node.js / Frontend Build Outputs & Dependencies
# -----------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/node_modules/
.npm/
.eslintcache
*.tsbuildinfo

# Generated static assets served by ASP.NET Core
backend/wwwroot/assets/
backend/wwwroot/index.html
backend/wwwroot/favicon.svg

# -----------------------------------------------------------------------------
# Environment & Secret Files
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# -----------------------------------------------------------------------------
# Logs & Diagnostic Files
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Operating System & IDE Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
*.swp
*~

# VS Code (ignore workspace state, keep recommendations)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -----------------------------------------------------------------------------
# Runtime Download & Storage Folders
# -----------------------------------------------------------------------------
downloads/
media/
data/
archives/
ChannelPhotos/
*.part
*.ytdl

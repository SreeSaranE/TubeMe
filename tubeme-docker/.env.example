# =============================================================================
# TubeMe Docker Environment Configuration (Template)
# Modeled after Immich deployment architecture
# =============================================================================

# TubeMe Web UI & API host port
TUBEME_HOST_PORT=5000

# Directory where downloaded videos and audio files are stored on the host
DOWNLOAD_LOCATION=../tubeme-media

# Directory where application data, SQLite DB, archives, and YouTube cookies are stored
DATA_LOCATION=../backend/database

# Host timezone (e.g. Etc/UTC, America/New_York, Asia/Kolkata)
TZ=Asia/Kolkata
